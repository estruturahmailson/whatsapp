{
  "name": "whatsapp-followup-agent",
  "version": "1.0.0",
  "description": "Agente de follow-up no WhatsApp (Z-API + Claude) com painel web de aprovação",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.1.0",
    "node-cron": "^3.0.3"
  }
}
