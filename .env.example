# Porta do servidor
PORT=3000

# Senha de acesso ao painel (obrigatória)
PANEL_PASSWORD=troque-esta-senha

# Segredo usado na URL do webhook (/webhook/<WEBHOOK_SECRET>)
WEBHOOK_SECRET=gere-um-valor-aleatorio

# URL pública do servidor (usada para mostrar a URL do webhook no painel)
PUBLIC_URL=https://seu-app.exemplo.com

# Chave da API da Anthropic (Claude)
ANTHROPIC_API_KEY=

# Credenciais Z-API (também podem ser preenchidas no painel)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Onde salvar o banco SQLite (use um disco persistente em produção)
DATA_DIR=./data
